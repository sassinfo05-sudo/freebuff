# Copy to .env and fill in. Never commit the real .env (it's gitignored at the repo root).

APP_ENV=dev

# Required — no defaults.
MONGO_URL=mongodb://localhost:27017
DB_NAME=zanelvo_devstudio
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me

# Optional.
SECRETS_ENC_KEY=
CORS_ORIGINS=http://localhost:5173

# LLM/GitHub credentials can instead be set from the app's own Settings screen once it's
# running (encrypted at rest) — see app/devstudio/services/settings_service.py. These env vars
# override the stored value when present:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEVSTUDIO_GITHUB_TOKEN=
EMERGENT_UNIVERSAL_KEY=

# Amazon Bedrock (optional — an AWS-routed alternative to ANTHROPIC_API_KEY for the same Claude
# models). AWS_REGION is required to use Bedrock at all; the key pair is optional — leave both
# blank to use boto3's own default AWS credential chain (shared config file, an IAM role) instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=

# Gemini Enterprise Agent Platform (optional — Google Cloud's product formerly known as Vertex AI;
# a GCP-routed alternative to GEMINI_API_KEY for the same Gemini models). GOOGLE_CLOUD_PROJECT is
# required to use it at all; the service account key is optional — leave it blank to use Google's
# own Application Default Credentials (gcloud login, or an attached GCP service account) instead.
# Vertex AI does not accept API keys, so GEMINI_API_KEY above does not apply here.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Raw service account key JSON contents (not a file path) — Dev Studio's own env var, distinct
# from the real GOOGLE_APPLICATION_CREDENTIALS (a file path, already handled by Application
# Default Credentials without any config here).
GOOGLE_APPLICATION_CREDENTIALS_JSON=
